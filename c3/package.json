{
  "name": "c3",
  "version": "0.1.0",
  "description": "Contenedor del cliente (track C). Por ahora: solo el receptor.",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "TENANT_ID=tenant-01 C3_PORT=3001 DATABASE_URL=postgres://cw:cwlocal@127.0.0.1:5433/rpf_c3_tenant01 node --env-file=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "prestart": "tsc",
    "prestart:2": "tsc",
    "start:2": "TENANT_ID=tenant-02 C3_PORT=3002 DATABASE_URL=postgres://cw:cwlocal@127.0.0.1:5433/rpf_c3_tenant02 node --env-file=.env dist/main.js",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/*.test.js\"",
    "e2e:kms": "tsc -p tsconfig.test.json && node --env-file=.env dist-test/test/e2e-kms.js",
    "start:local": "TENANT_ID=tenant-01 C3_PORT=3001 DATABASE_URL=postgres://cw:cwlocal@127.0.0.1:5433/rpf_c3_tenant01 KMS_SIGN_KEY_ID= KMS_HMAC_KEY_ID= KMS_ENCRYPT_KEY_ID= node --env-file=.env dist/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1121.0",
    "@aws-sdk/client-sqs": "^3.1121.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^12.0.1",
    "@nestjs/swagger": "^11.4.7",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}