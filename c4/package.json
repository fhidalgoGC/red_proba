{
  "name": "c4",
  "version": "0.1.0",
  "description": "Consumidor de C4 (track G). Hoy solo recibe de la cola FIFO y registra la llegada.",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/*.test.js\"",
    "e2e": "tsc -p tsconfig.test.json && node dist-test/test/e2e.js",
    "informe": "tsc -p tsconfig.json && node dist/cli/informe.js"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1121.0",
    "@aws-sdk/client-sqs": "^3.716.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.7.0"
  }
}
